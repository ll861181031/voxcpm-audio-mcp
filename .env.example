# Existing local installations
VOXCPM_HOME=D:\Desktop\VoxCPM2
VOXCPM_URL=http://127.0.0.1:8808
VOXCPM_PYTHON=D:\Desktop\VoxCPM2\.venv\Scripts\python.exe
VOXCPM_START_SCRIPT=D:\Desktop\VoxCPM2\Start-VoxCPM.ps1

SOULX_HOME=D:\Desktop\SoulX-Singer
SOULX_PYTHON=D:\Desktop\SoulX-Singer\.venv\Scripts\python.exe
SOULX_MODEL_PATH=D:\Desktop\SoulX-Singer\pretrained_models\SoulX-Singer\model.pt
SOULX_CONFIG=D:\Desktop\SoulX-Singer\soulxsinger\config\soulxsinger.yaml
SOULX_PHONESET=D:\Desktop\SoulX-Singer\soulxsinger\utils\phoneme\phone_set.json
SOULX_PROMPT_WAV=D:\Desktop\SoulX-Singer\example\audio\zh_prompt.wav
SOULX_PROMPT_METADATA=D:\Desktop\SoulX-Singer\example\audio\zh_prompt.json

FFMPEG=D:\Desktop\VoxCPM2\tools\ffmpeg\bin\ffmpeg.exe
AUDIO_OUTPUT_DIR=%USERPROFILE%\Music\VoxCPM-MCP
MCP_LOG_DIR=%LOCALAPPDATA%\OpenAI\Codex\Plugins\voxcpm-audio-mcp\logs
VOICE_PRESETS_PATH=%LOCALAPPDATA%\OpenAI\Codex\Plugins\voxcpm-audio-mcp\voice_presets.json
MIN_FREE_VRAM_MB=6000
REQUEST_TIMEOUT_S=3600
MAX_TEXT_CHARS=2000
